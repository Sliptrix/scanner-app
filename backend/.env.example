# Scanner Backend Environment Configuration
# Copy this file to .env and fill in your values

# ── Required ──────────────────────────────────────────────
# QR Code Generator API key (required — server won't start without it)
QR_API_KEY=your-api-key-here

# ── Server ────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# Public URL for QR code destinations (what gets encoded in QR codes)
PUBLIC_URL=https://scanner.lonewolfgenetics.com

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=https://scanner.lonewolfgenetics.com

# ── Admin ─────────────────────────────────────────────────
# Comma-separated admin email addresses (for edit permissions)
ADMIN_EMAILS=pozersky@lonewolfgenetics.com,aterkonda@lonewolfgenetics.com

# ── SharePoint / HQ Workbook ─────────────────────────────
# Full URL to the SharePoint Excel workbook (Active_Inventory sheet)
SHAREPOINT_WORKBOOK_URL=

# ── Zebra Label Printer (raw TCP) ────────────────────────
ZEBRA_PRINTER_IP=192.168.1.100
ZEBRA_PRINTER_PORT=9100
