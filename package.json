{
  "name": "lab-scanner-system",
  "version": "1.0.0",
  "description": "Lab Barcode Builder & Transfer System",
  "main": "public/index.html",
  "scripts": {
    "start": "python3 -m http.server 8000 --directory public",
    "test": "echo \"Running tests...\" && npm run test:unit && npm run test:phase5 && npm run test:integration && npm run test:e2e && npm run test:smoke",
    "test:unit": "node tests/transfer-split-mode.test.js",
    "test:phase5": "node tests/phase5-analytics.test.js",
    "test:integration": "node tests/integration/integration-test-suite.js",
    "test:e2e": "node tests/e2e-critical-paths.test.js",
    "test:smoke": "node tests/smoke-test.js",
    "validate": "echo \"Validating build...\" && npm run start"
  },
  "keywords": [
    "lab",
    "barcode",
    "scanner",
    "container",
    "transfer"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "http-server": "^14.1.1",
    "jsdom": "^26.1.0"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
